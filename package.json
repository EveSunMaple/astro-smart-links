{
  "name": "astro-smart-links",
  "type": "module",
  "version": "1.0.0",
  "packageManager": "pnpm@11.8.0",
  "description": "An Astro integration that adds smart styling and broken-link detection to internal and external links",
  "author": "EveSunMaple",
  "license": "MIT",
  "homepage": "https://astro-smart-links.vercel.app/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/EveSunMaple/astro-smart-links.git"
  },
  "bugs": "https://github.com/EveSunMaple/astro-smart-links/issues",
  "keywords": [
    "astro",
    "astro-integration",
    "rehype",
    "rehype-plugin",
    "links",
    "external-links",
    "broken-links",
    "markdown",
    "html",
    "smart-links"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "astro-smart-links": "dist/cli.js",
    "rehype-smart-links": "dist/cli.js"
  },
  "files": [
    "LICENSE",
    "README.md",
    "README.zh-CN.md",
    "dist"
  ],
  "engines": {
    "node": ">=18.17.0"
  },
  "scripts": {
    "build": "tsup src/index.ts src/cli.ts --format esm --dts --clean",
    "dev": "tsup src/index.ts src/cli.ts --format esm --dts --watch --clean",
    "example": "cd example && pnpm dev",
    "example:build": "cd example && pnpm build",
    "lint": "eslint . --ext .ts",
    "lint:fix": "eslint . --ext .ts --fix",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:dev": "node tests/serve-report.js",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "prepublishOnly": "pnpm build"
  },
  "peerDependencies": {
    "astro": ">=4.0.0"
  },
  "peerDependenciesMeta": {
    "astro": {
      "optional": true
    }
  },
  "dependencies": {
    "@types/hast": "^3.0.4",
    "commander": "^11.1.0",
    "rehype-parse": "^9.0.1",
    "rehype-stringify": "^10.0.1",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.0.0",
    "vfile": "^6.0.3"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^3.16.0",
    "@types/node": "^18.19.86",
    "@typescript-eslint/eslint-plugin": "^8.29.0",
    "@typescript-eslint/parser": "^8.29.0",
    "@vitest/ui": "3.1.1",
    "astro": "^5.6.0",
    "cheerio": "^1.0.0",
    "eslint": "^9.24.0",
    "eslint-plugin-astro": "^1.3.1",
    "eslint-plugin-format": "^1.0.1",
    "eslint-plugin-import": "^2.31.0",
    "globals": "^16.0.0",
    "hastscript": "^9.0.1",
    "tsup": "^7.2.0",
    "typescript": "^5.8.3",
    "vitest": "^3.1.1"
  }
}
