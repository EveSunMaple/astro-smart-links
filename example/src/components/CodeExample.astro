---
// CodeExample.astro
interface Props {
  title: string;
  internalLinkHtml: string;
  externalLinkHtml: string;
  brokenLinkHtml: string;
  lang?: "zh" | "en";
}

const { title, internalLinkHtml, externalLinkHtml, brokenLinkHtml } = Astro.props;

// Derive the labels from the current Starlight locale unless overridden.
const currentLocale = Astro.currentLocale ?? "";
const lang: "zh" | "en" = Astro.props.lang ?? (currentLocale.toLowerCase().startsWith("en") ? "en" : "zh");

// Translations for different languages
const translations = {
  zh: {
    internalLink: "内部链接",
    externalLink: "外部链接",
    brokenLink: "断开链接"
  },
  en: {
    internalLink: "Internal Link",
    externalLink: "External Link",
    brokenLink: "Broken Link"
  }
};

// Get the correct translation
const t = translations[lang];
---

<div class="code-example not-content mt-8 mb-12">
  <!-- Plain utilities instead of the daisyUI card component: its `.card figure`
       rule would restyle Expressive Code's <figure> frame. -->
  <div class="rounded-2xl border border-base-300 bg-base-200 text-base-content p-4 sm:p-6">
    <h3 class="text-lg font-bold">{title}</h3>
    
    <div class="grid grid-cols-1 md:grid-cols-3 gap-4 mt-4 mb-6">
      <div class="bg-base-100 p-4 rounded-lg">
        <h4 class="font-semibold mb-2">{t.internalLink}</h4>
        <div class="bg-base-100 rounded p-3 min-h-12 flex items-center border border-base-300 bg-pattern">
          <Fragment set:html={internalLinkHtml} />
        </div>
      </div>
      
      <div class="bg-base-100 p-4 rounded-lg">
        <h4 class="font-semibold mb-2">{t.externalLink}</h4>
        <div class="bg-base-100 rounded p-3 min-h-12 flex items-center border border-base-300 bg-pattern">
          <Fragment set:html={externalLinkHtml} />
        </div>
      </div>
      
      <div class="bg-base-100 p-4 rounded-lg">
        <h4 class="font-semibold mb-2">{t.brokenLink}</h4>
        <div class="bg-base-100 rounded p-3 min-h-12 flex items-center border border-base-300 bg-pattern">
          <Fragment set:html={brokenLinkHtml} />
        </div>
      </div>
    </div>
    
    <div class="mt-2">
      <slot />
    </div>
  </div>
</div>
<style>
.bg-pattern {
  background-image: repeating-linear-gradient(
    135deg,
    color-mix(in oklab, var(--color-base-content) 12%, transparent) 9px,
    color-mix(in oklab, var(--color-base-content) 12%, transparent) 10px,
    transparent 10px,
    transparent 20px
  );
}
</style>
